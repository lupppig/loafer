# Loafer environment variables
# Copy to .env and fill in values. .env is gitignored — never commit real keys.

# LLM providers. Each provider reads its own variable when `llm.api_key` is not
# set in the pipeline config (see loafer/runner.py:_PROVIDER_ENV_VARS).
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
DASHSCOPE_API_KEY=your-qwen-api-key-here

# Database connections (used in pipeline configs via ${VAR})
POSTGRES_URL=postgresql://loafer:loafer@localhost:5432/loafer_dev
MONGO_URL=mongodb://loafer:loafer@localhost:27017

# Integration database for the ELT tests in examples/ai_transform_tests.py
LOAFER_PG_URL=postgresql://loafer:loafer@127.0.0.1:55432/loafer_test

# Self-hosted release profile. Pin LOAFER_IMAGE to the released digest rather
# than using latest. URL-encode special characters in POSTGRES_PASSWORD when
# embedding it in LOAFER_METADATA_URL.
LOAFER_IMAGE=ghcr.io/lupppig/loafer:0.5.0@sha256:replace-with-release-digest
NATS_IMAGE=nats:2.11.8-alpine3.22@sha256:71092f77d707a4a81b12aca5096d6b2d2e07ad16aa57c84066940a17af74f61a
# Compose mounts these values as files. Use four independently generated
# passwords; never reuse the database or application secrets.
NATS_RELAY_PASSWORD=replace-with-a-long-random-relay-password
NATS_ETL_PASSWORD=replace-with-a-long-random-etl-password
NATS_DOCUMENT_PASSWORD=replace-with-a-long-random-document-password
NATS_BROWSER_PASSWORD=replace-with-a-long-random-browser-password
POSTGRES_USER=loafer
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=loafer
LOAFER_METADATA_URL=postgresql://loafer:replace-with-a-long-random-password@postgres:5432/loafer
LOAFER_AUTH_ISSUER=https://loafer.example.com
LOAFER_AUTH_AUDIENCE=https://api.loafer.example.com
LOAFER_AUTH_JWKS_URL=https://loafer.example.com/api/auth/jwks
LOAFER_ALLOWED_ORIGINS=https://loafer.example.com
LOAFERD_PORT=9443

# Web and Better Auth boundary. Both ports publish to host loopback only; put
# your own TLS-terminating reverse proxy in front of LOAFER_WEB_PORT and point
# BETTER_AUTH_URL at that public origin.
LOAFER_WEB_IMAGE=ghcr.io/lupppig/loafer-web:0.5.0@sha256:replace-with-release-digest
LOAFER_WEB_PORT=3000
BETTER_AUTH_URL=https://loafer.example.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_DATABASE_URL=postgresql://loafer:replace-with-a-long-random-password@postgres:5432/loafer
LOAFER_AUTH_EMAIL_ENDPOINT=https://mail.loafer.example.com/send
# The browser-to-web hop is HTTPS at your proxy; web-to-loaferd stays on the
# private compose network. Override only if loaferd runs elsewhere.
LOAFERD_INTERNAL_URL=http://loaferd:9443
